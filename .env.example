# Copy this file to .env and replace these placeholders locally.
# Never put real passwords or keys in this example file or commit them.
CHECKIN_ADMIN_PASSWORD=replace-with-a-strong-unique-password
FLASK_SECRET_KEY=replace-with-a-random-secret-from-secrets-token-urlsafe
AZURE_FACE_ENDPOINT=https://your-face-resource.cognitiveservices.azure.com
AZURE_FACE_KEY=replace-with-your-azure-face-key
AZURE_FACE_MATCH_THRESHOLD=0.75
